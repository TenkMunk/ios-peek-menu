# Telegram-iOS / ContextControllerExtractedPresentationNode + ContextSourceContainer.
# These are source timings, not measurements of an iPhone screen recording.
IOS_OPEN_MS = 420
IOS_BACKDROP_MS = 200
IOS_ACTION_FADE_MS = 50
IOS_CLOSE_MS = 200
IOS_REACTION_MS = 400
_motion_interpolators = {}


def _spring_progress(fraction, damping=104.0):
    """Unit step of the iOS mass=5, stiffness=900 spring, with zero velocity.

    Core Animation's settlingDuration is platform-defined. Normalize an analytic
    0.1% envelope to the requested Android duration; the clock is an adaptation.
    The small physical overshoot is retained instead of adding an arbitrary bounce.
    """
    fraction = max(0.0, min(1.0, float(fraction)))
    if fraction == 0.0 or fraction == 1.0:
        return fraction
    mass, stiffness = 5.0, 900.0
    decay = float(damping) / (2.0 * mass)
    frequency = math.sqrt(stiffness / mass - decay * decay)
    envelope = math.sqrt(1.0 + (decay / frequency) ** 2)
    settle_time = math.log(envelope / 0.001) / decay
    t = fraction * settle_time
    return 1.0 - math.exp(-decay * t) * (
        math.cos(frequency * t) + decay / frequency * math.sin(frequency * t))


def _ios_interpolator(kind="spring"):
    """Sample once into an Android PathInterpolator: no Python frame callbacks."""
    cached = _motion_interpolators.get(kind)
    if cached is not None:
        return cached
    try:
        cls = jclass("android.view.animation.PathInterpolator")
        if kind == "ease":
            interpolator = cls(jfloat(0.42), jfloat(0.0), jfloat(0.58), jfloat(1.0))
        else:
            path = jclass("android.graphics.Path")()
            path.moveTo(jfloat(0.0), jfloat(0.0))
            damping = 88.0 if kind == "reaction" else 104.0
            for i in range(1, 161):
                fraction = i / 160.0
                path.lineTo(jfloat(fraction), jfloat(_spring_progress(fraction, damping)))
            interpolator = cls(path)
    except Exception as error:
        diag_once("motion-curve:" + kind, f"native motion curve unavailable; using fallback: {error}")
        interpolator = DecelerateInterpolator() if kind == "ease" else OvershootInterpolator(0.7)
    _motion_interpolators[kind] = interpolator
    return interpolator


def diag_once(key, message):
    if key not in _diag_once_keys:
        _diag_once_keys.add(key)
        diag(message)


def load_diag(message):
    _load_diagnostics.append(str(message))
    del _load_diagnostics[:-40]
    diag(message)


